    },
    {
      "name": "6 - Authentication",
      "description": "There is no separate login endpoint. The API uses HTTP Basic authentication on every protected request. View/Borrow/Return/My History use client credentials; Manage/Complete History use owner credentials.",
      "item": []
    }
  ]
