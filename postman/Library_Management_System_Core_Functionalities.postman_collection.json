    {
      "name": "2 - Borrow Book",
      "description": "Clients can borrow an available book. The setup request creates isolated test data; the successful borrow saves loanId for the following folders.",
      "item": [
        {
          "name": "Setup - Create an available book for the borrow test",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const suffix = Date.now().toString().slice(-10).padStart(10, \"0\");",
                  "pm.collectionVariables.set(\"borrowIsbn\", `978${suffix}`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Borrow-test book is created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "const book = pm.response.json();",
                  "pm.collectionVariables.set(\"borrowBookId\", book.id);",
                  "pm.test(\"Borrow-test book is available\", function () {",
                  "    pm.expect(book.isbn).to.eql(pm.collectionVariables.get(\"borrowIsbn\"));",
                  "    pm.expect(book.availableCopies).to.be.above(0);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{ownerUsername}}",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "{{ownerPassword}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isbn\": \"{{borrowIsbn}}\",\n  \"title\": \"Postman Demo Book\",\n  \"author\": \"Postman Runner\",\n  \"description\": \"Created automatically by the Postman collection.\",\n  \"totalCopies\": 2\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/books",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "books"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Client borrows an available book",
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{clientUsername}}",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "{{clientPassword}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bookId\": {{borrowBookId}},\n  \"loanDays\": 14\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/loans",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "loans"
              ]
            },
            "description": "Borrows the available book created by the setup request and stores the returned loan ID for the Return Book and Book History folders."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Client borrows an available copy\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "const loan = pm.response.json();",
                  "pm.collectionVariables.set(\"loanId\", loan.id);",
                  "pm.test(\"Loan is active\", function () {",
                  "    pm.expect(loan.status).to.eql(\"ACTIVE\");",
                  "    pm.expect(loan.returnedAt).to.eql(null);",
                  "    pm.expect(loan.returnedLate).to.eql(false);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Client cannot borrow the same book twice",
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{clientUsername}}",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "{{clientPassword}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bookId\": {{borrowBookId}},\n  \"loanDays\": 14\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/loans",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "loans"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Duplicate active loan returns 409\", function () {",
                  "    pm.response.to.have.status(409);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3 - Return Book",
      "description": "Clients can return their active loans; attempting the same return twice produces a conflict.",
      "item": [
        {
          "name": "Client returns the loan",
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{clientUsername}}",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "{{clientPassword}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/loans/{{loanId}}/return",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "loans",
                "{{loanId}}",
                "return"
              ]
            },
            "description": "Returns the active loan. The Spring Boot console should also log the after-commit BookReturnedEvent."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Client returns the loan\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    const loan = pm.response.json();",
                  "    pm.expect(loan.status).to.eql(\"RETURNED_ON_TIME\");",
                  "    pm.expect(loan.returnedLate).to.eql(false);",
                  "    pm.expect(loan.returnedAt).to.be.a(\"string\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Returning the same loan again fails",
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{clientUsername}}",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "{{clientPassword}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/loans/{{loanId}}/return",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "loans",
                "{{loanId}}",
                "return"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Repeated return produces a conflict\", function () {",
                  "    pm.response.to.have.status(409);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
