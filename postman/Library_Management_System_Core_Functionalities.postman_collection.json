    {
      "name": "1 - View Books",
      "description": "Both roles can view and search the list of active books.",
      "item": [
        {
          "name": "Client can view books",
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{clientUsername}}",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "{{clientPassword}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/books",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "books"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Client receives the inventory\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.content).to.be.an(\"array\");",
                  "    pm.expect(body.page.totalElements).to.be.at.least(3);",
                  "});"
                ]
              }
            }
          ]
        },
