    {
      "name": "5 - Book History",
      "description": "Tracks the borrower, borrowed time, due time, returned time, returned-late flag, and calculated loan status.",
      "item": [
        {
          "name": "Client views the returned loan record",
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{clientUsername}}",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "{{clientPassword}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
