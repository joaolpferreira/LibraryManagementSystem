          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Search returns Clean Code\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    const books = pm.response.json().content;",
                  "    pm.expect(books.some(book => book.title === \"Clean Code\")).to.be.true;",
