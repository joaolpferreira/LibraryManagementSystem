        {
          "name": "Owner creates a demo book",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const suffix = Date.now().toString().slice(-10).padStart(10, \"0\");",
                  "pm.collectionVariables.set(\"demoIsbn\", `978${suffix}`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Owner creates a book\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "const book = pm.response.json();",
                  "pm.collectionVariables.set(\"createdBookId\", book.id);",
                  "pm.test(\"Created book has all copies available\", function () {",
                  "    pm.expect(book.isbn).to.eql(pm.collectionVariables.get(\"demoIsbn\"));",
                  "    pm.expect(book.totalCopies).to.eql(2);",
                  "    pm.expect(book.availableCopies).to.eql(2);",
                  "});"
                ]
              }
            }
          ],
