                "exec": [
                  "pm.test(\"Client borrows an available copy\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "const loan = pm.response.json();",
                  "pm.collectionVariables.set(\"loanId\", loan.id);",
                  "pm.test(\"Loan is active\", function () {",
                  "    pm.expect(loan.status).to.eql(\"ACTIVE\");",
