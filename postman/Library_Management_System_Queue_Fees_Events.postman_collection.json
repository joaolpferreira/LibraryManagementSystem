{
  "info": {
    "_postman_id": "fc3a8ea7-4ca7-45e7-8961-dd2030579cf4",
    "name": "Library Management System - Queue, Fees and Events",
    "description": "A focused collection for testing the FIFO reservation queue, automatic late-fee registration, and the state produced by book-return events. Run requests in numerical order. The second client defaults to client2/client123; change the collection variables if your database uses different credentials. Spring application events are visible in the application logs, not as an HTTP response stream.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080", "type": "string" },
    { "key": "borrowerUsername", "value": "client", "type": "string" },
    { "key": "borrowerPassword", "value": "client123", "type": "string" },
    { "key": "queuedUsername", "value": "client2", "type": "string" },
    { "key": "queuedPassword", "value": "client123", "type": "string" },
    { "key": "ownerUsername", "value": "owner", "type": "string" },
    { "key": "ownerPassword", "value": "owner123", "type": "string" },
    { "key": "queueBookId", "value": "2", "type": "string" },
    { "key": "lateBookId", "value": "3", "type": "string" },
    { "key": "queueLoanId", "value": "", "type": "string" },
    { "key": "reservationId", "value": "", "type": "string" },
    { "key": "reservedLoanId", "value": "", "type": "string" },
    { "key": "lateLoanId", "value": "", "type": "string" },
    { "key": "lateFeeId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "1 - FIFO Reservation Queue",
      "description": "Use a book with exactly one available copy. The seeded book 2 has one copy in a clean database. Requests 1.1 and 1.2 use different clients.",
      "item": [
        {
          "name": "1.1 Borrow Last Copy - Client A",
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "{{borrowerUsername}}", "type": "string" },
                { "key": "password", "value": "{{borrowerPassword}}", "type": "string" }
              ]
            },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bookId\": {{queueBookId}},\n  \"loanDays\": 14\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/loans",
            "description": "Client A borrows the final copy. Saves the returned loan ID as queueLoanId."
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test(\"Last copy borrowed\", () => pm.response.to.have.status(201));",
                "if (pm.response.code === 201) {",
                "  const loan = pm.response.json();",
                "  pm.collectionVariables.set(\"queueLoanId\", loan.id);",
                "  pm.expect(loan.status).to.eql(\"ACTIVE\");",
                "}"
              ]
            }
          }],
          "response": []
        },
        {
          "name": "1.2 Join Queue - Client B",
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "{{queuedUsername}}", "type": "string" },
                { "key": "password", "value": "{{queuedPassword}}", "type": "string" }
              ]
            },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bookId\": {{queueBookId}}\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/reservations",
            "description": "Client B joins the FIFO queue. Saves the reservation ID. Expected status: WAITING and queuePosition: 1."
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test(\"Reservation created\", () => pm.response.to.have.status(201));",
                "if (pm.response.code === 201) {",
                "  const reservation = pm.response.json();",
                "  pm.collectionVariables.set(\"reservationId\", reservation.id);",
                "  pm.test(\"Client is waiting at position 1\", () => {",
                "    pm.expect(reservation.status).to.eql(\"WAITING\");",
                "    pm.expect(reservation.queuePosition).to.eql(1);",
                "  });",
                "}"
              ]
            }
          }],
          "response": []
        },
        {
          "name": "1.3 Inspect Active Queue - Owner",
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "{{ownerUsername}}", "type": "string" },
                { "key": "password", "value": "{{ownerPassword}}", "type": "string" }
              ]
            },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/reservations/books/{{queueBookId}}/queue?page=0&size=20",
            "description": "The owner sees the active queue in FIFO order."
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test(\"Owner can inspect the queue\", () => pm.response.to.have.status(200));",
                "if (pm.response.code === 200) {",
                "  const page = pm.response.json();",
                "  pm.expect(page.content.some(item => String(item.id) === String(pm.collectionVariables.get(\"reservationId\")))).to.be.true;",
                "}"
              ]
            }
          }],
          "response": []
        },
        {
          "name": "1.4 Return Copy - Emits Return and Reservation Events",
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "{{borrowerUsername}}", "type": "string" },
                { "key": "password", "value": "{{borrowerPassword}}", "type": "string" }
              ]
            },
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/loans/{{queueLoanId}}/return",
            "description": "Returns the copy. After commit, the application logs Book returned and Reservation ready events. Keep the IntelliJ Run console visible."
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test(\"Book returned\", () => pm.response.to.have.status(200));",
                "if (pm.response.code === 200) {",
                "  const loan = pm.response.json();",
                "  pm.expect(loan.returnedAt).to.not.be.null;",
                "  console.log(\"Return completed. Check the application console for: Book returned and Reservation ready\", loan);",
                "}"
              ]
            }
          }],
          "response": []
        },
        {
          "name": "1.5 Verify Reservation Is READY - Client B",
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "{{queuedUsername}}", "type": "string" },
                { "key": "password", "value": "{{queuedPassword}}", "type": "string" }
              ]
            },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/reservations/{{reservationId}}",
            "description": "Verifies the committed effect of ReservationReadyEvent. Expected status: READY with readyAt and expiresAt."
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test(\"Reservation can be read\", () => pm.response.to.have.status(200));",
                "if (pm.response.code === 200) {",
                "  const reservation = pm.response.json();",
                "  pm.test(\"Reservation is ready\", () => {",
                "    pm.expect(reservation.status).to.eql(\"READY\");",
                "    pm.expect(reservation.readyAt).to.not.be.null;",
                "    pm.expect(reservation.expiresAt).to.not.be.null;",
                "  });",
                "}"
              ]
            }
          }],
          "response": []
        },
        {
          "name": "1.6 Borrow Allocated Copy - Client B",
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "{{queuedUsername}}", "type": "string" },
                { "key": "password", "value": "{{queuedPassword}}", "type": "string" }
              ]
            },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bookId\": {{queueBookId}},\n  \"loanDays\": 14\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/loans",
            "description": "Client B claims the copy allocated by the READY reservation."
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test(\"Allocated copy borrowed\", () => pm.response.to.have.status(201));",
                "if (pm.response.code === 201) {",
                "  pm.collectionVariables.set(\"reservedLoanId\", pm.response.json().id);",
                "}"
              ]
            }
          }],
          "response": []
        },
        {
          "name": "1.7 Verify Reservation Is FULFILLED",
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "{{queuedUsername}}", "type": "string" },
                { "key": "password", "value": "{{queuedPassword}}", "type": "string" }
              ]
            },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/reservations/{{reservationId}}",
            "description": "Expected status: FULFILLED with fulfilledAt populated."
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test(\"Reservation can be read\", () => pm.response.to.have.status(200));",
                "if (pm.response.code === 200) {",
                "  const reservation = pm.response.json();",
                "  pm.expect(reservation.status).to.eql(\"FULFILLED\");",
                "  pm.expect(reservation.fulfilledAt).to.not.be.null;",
                "}"
              ]
            }
          }],
          "response": []
        }
      ]
    },
    {
      "name": "2 - Late-Fee Registration",
      "description": "Run 2.1, then simulate time in PostgreSQL before running 2.2. Use: UPDATE loans SET borrowed_at = CURRENT_TIMESTAMP - INTERVAL '49 hours', due_at = CURRENT_TIMESTAMP - INTERVAL '25 hours' WHERE id = <lateLoanId> AND returned_at IS NULL; Replace <lateLoanId> with the collection variable value shown by Postman.",
      "item": [
        {
          "name": "2.1 Borrow Late-Test Book",
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "{{borrowerUsername}}", "type": "string" },
                { "key": "password", "value": "{{borrowerPassword}}", "type": "string" }
              ]
            },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bookId\": {{lateBookId}},\n  \"loanDays\": 1\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/loans",
            "description": "Creates a normal one-day loan and saves lateLoanId. Run the SQL from the folder description before request 2.2."
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test(\"Late-test loan created\", () => pm.response.to.have.status(201));",
                "if (pm.response.code === 201) {",
                "  const loan = pm.response.json();",
                "  pm.collectionVariables.set(\"lateLoanId\", loan.id);",
                "  console.log(\"lateLoanId =\", loan.id);",
                "}"
              ]
            }
          }],
          "response": []
        },
        {
          "name": "2.2 Return Overdue Book - Registers Fee and Emits Events",
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "{{borrowerUsername}}", "type": "string" },
                { "key": "password", "value": "{{borrowerPassword}}", "type": "string" }
              ]
            },
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/loans/{{lateLoanId}}/return",
            "description": "After the SQL time adjustment, this return atomically registers a late fee. After commit, the console shows Late fee registered and Book returned."
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test(\"Overdue book returned\", () => pm.response.to.have.status(200));",
                "if (pm.response.code === 200) {",
                "  const loan = pm.response.json();",
                "  pm.test(\"Return is marked late\", () => {",
                "    pm.expect(loan.returnedLate).to.be.true;",
                "    pm.expect(loan.status).to.eql(\"RETURNED_LATE\");",
                "  });",
                "  console.log(\"Check application logs for Late fee registered and Book returned\", loan);",
                "}"
              ]
            }
          }],
          "response": []
        },
        {
          "name": "2.3 Verify My OUTSTANDING Fee",
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "{{borrowerUsername}}", "type": "string" },
                { "key": "password", "value": "{{borrowerPassword}}", "type": "string" }
              ]
            },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/late-fees/my?status=OUTSTANDING&page=0&size=20",
            "description": "Finds the fee created for lateLoanId and saves its ID as lateFeeId. With the suggested SQL it should normally charge two days."
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test(\"Late-fee list returned\", () => pm.response.to.have.status(200));",
                "if (pm.response.code === 200) {",
                "  const page = pm.response.json();",
                "  const fee = page.content.find(item => String(item.loanId) === String(pm.collectionVariables.get(\"lateLoanId\")));",
                "  pm.test(\"Fee exists for the returned loan\", () => pm.expect(fee).to.exist);",
                "  if (fee) {",
                "    pm.collectionVariables.set(\"lateFeeId\", fee.id);",
                "    pm.expect(fee.status).to.eql(\"OUTSTANDING\");",
                "    pm.expect(Number(fee.amount)).to.be.above(0);",
                "  }",
                "}"
              ]
            }
          }],
          "response": []
        },
        {
          "name": "2.4 Inspect Registered Fee - Owner",
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "{{ownerUsername}}", "type": "string" },
                { "key": "password", "value": "{{ownerPassword}}", "type": "string" }
              ]
            },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/late-fees/{{lateFeeId}}",
            "description": "The owner can inspect the persisted calculation, rate, amount, currency and status."
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test(\"Owner can inspect the fee\", () => pm.response.to.have.status(200));",
                "if (pm.response.code === 200) {",
                "  const fee = pm.response.json();",
                "  pm.expect(String(fee.loanId)).to.eql(String(pm.collectionVariables.get(\"lateLoanId\")));",
                "  pm.expect(fee.status).to.eql(\"OUTSTANDING\");",
                "}"
              ]
            }
          }],
          "response": []
        }
      ]
    },
    {
      "name": "3 - Event Outcome Checks",
      "description": "These requests inspect persisted effects. For the actual in-process events, watch the Spring application console while running requests 1.4 and 2.2.",
      "item": [
        {
          "name": "3.1 Inspect Returned Queue Loan",
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "{{borrowerUsername}}", "type": "string" },
                { "key": "password", "value": "{{borrowerPassword}}", "type": "string" }
              ]
            },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/loans/{{queueLoanId}}",
            "description": "Confirms returnedAt and the final loan status after BookReturnedEvent was published."
          },
          "response": []
        },
        {
          "name": "3.2 Inspect Late Loan",
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "{{borrowerUsername}}", "type": "string" },
                { "key": "password", "value": "{{borrowerPassword}}", "type": "string" }
              ]
            },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/loans/{{lateLoanId}}",
            "description": "Confirms returnedLate=true and status RETURNED_LATE."
          },
          "response": []
        }
      ]
    }
  ]
}
