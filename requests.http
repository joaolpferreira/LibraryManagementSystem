@baseUrl = http://localhost:8080
@ownerUsername = owner
@ownerPassword = owner123
@clientUsername = client
@clientPassword = client123

### Search books as a client
GET {{baseUrl}}/api/books?query=clean&availableOnly=true
Authorization: Basic {{clientUsername}} {{clientPassword}}

### Add a book as the owner
POST {{baseUrl}}/api/books
Authorization: Basic {{ownerUsername}} {{ownerPassword}}
Content-Type: application/json

{
  "isbn": "9780321356680",
  "title": "Effective Java",
  "author": "Joshua Bloch",
  "description": "Best practices for the Java platform.",
  "totalCopies": 2
}

### Borrow a seeded book as the client
POST {{baseUrl}}/api/loans
Authorization: Basic {{clientUsername}} {{clientPassword}}
Content-Type: application/json

{
  "bookId": 1,
  "loanDays": 14
}

> {%
    client.global.set("loanId", response.body.id);
%}

### Return the loan created above
POST {{baseUrl}}/api/loans/{{loanId}}/return
Authorization: Basic {{clientUsername}} {{clientPassword}}

### View the client's loan history
GET {{baseUrl}}/api/loans/my
Authorization: Basic {{clientUsername}} {{clientPassword}}

### View all history as the owner
GET {{baseUrl}}/api/loans/history
Authorization: Basic {{ownerUsername}} {{ownerPassword}}

### View the client's outstanding late fees
GET {{baseUrl}}/api/late-fees/my?status=OUTSTANDING
Authorization: Basic {{clientUsername}} {{clientPassword}}

### View all late fees as the owner
GET {{baseUrl}}/api/late-fees
Authorization: Basic {{ownerUsername}} {{ownerPassword}}

### Record a late fee as paid (replace 1 with an existing fee ID)
POST {{baseUrl}}/api/late-fees/1/settlement
Authorization: Basic {{ownerUsername}} {{ownerPassword}}
Content-Type: application/json

{
  "action": "PAID",
  "note": "Receipt 42"
}

### Join the queue for an unavailable book
POST {{baseUrl}}/api/reservations
Authorization: Basic {{clientUsername}} {{clientPassword}}
Content-Type: application/json

{
  "bookId": 2
}

> {%
    client.global.set("reservationId", response.body.id);
%}

### View the client's reservation history
GET {{baseUrl}}/api/reservations/my
Authorization: Basic {{clientUsername}} {{clientPassword}}

### Inspect book 2's active FIFO queue as the owner
GET {{baseUrl}}/api/reservations/books/2/queue
Authorization: Basic {{ownerUsername}} {{ownerPassword}}

### Cancel the reservation created above
POST {{baseUrl}}/api/reservations/{{reservationId}}/cancel
Authorization: Basic {{clientUsername}} {{clientPassword}}

### Search the catalog in natural language
GET {{baseUrl}}/api/search/books/natural?question=Find%20available%20books%20by%20Martin%20Fowler
Authorization: Basic {{clientUsername}} {{clientPassword}}

### Get personalized recommendations
GET {{baseUrl}}/api/recommendations/my?limit=5
Authorization: Basic {{clientUsername}} {{clientPassword}}

### Enrich book 1 from Open Library as the owner
POST {{baseUrl}}/api/books/1/metadata/enrich
Authorization: Basic {{ownerUsername}} {{ownerPassword}}

### Read persisted metadata
GET {{baseUrl}}/api/books/1/metadata
Authorization: Basic {{clientUsername}} {{clientPassword}}

### Ask the grounded chat assistant
POST {{baseUrl}}/api/assistant/chat
Authorization: Basic {{clientUsername}} {{clientPassword}}
Content-Type: application/json

{
  "message": "Recommend a book for me"
}
